<mujoco model="dva_quadrotor_hover">
  <compiler angle="radian" coordinate="local"/>

  <option timestep="0.005" gravity="0 0 -9.81" integrator="RK4"/>

  <default>
    <geom contype="0" conaffinity="0" rgba="0.2 0.3 0.35 1"/>
    <site size="0.01" rgba="0.9 0.2 0.1 1"/>
    <general ctrllimited="true" ctrlrange="0 3.0"/>
  </default>

  <asset>
    <material name="dummy_mat" rgba="1 1 1 1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0 -3 4" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="5 5 0.05" rgba="0.85 0.85 0.8 1"/>

    <body name="quadrotor" pos="0 0 1">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="0.75" diaginertia="0.0023 0.0023 0.0040"/>

      <geom name="body" type="ellipsoid" size="0.055 0.04 0.02"/>
      <geom name="arm_x" type="capsule" fromto="-0.17 0 0 0.17 0 0" size="0.008"/>
      <geom name="arm_y" type="capsule" fromto="0 -0.17 0 0 0.17 0" size="0.008"/>

      <site name="rotor_fl" pos="0.13 0.13 0" zaxis="0 0 1"/>
      <site name="rotor_fr" pos="0.13 -0.13 0" zaxis="0 0 1"/>
      <site name="rotor_rl" pos="-0.13 0.13 0" zaxis="0 0 1"/>
      <site name="rotor_rr" pos="-0.13 -0.13 0" zaxis="0 0 1"/>

      <camera name="front" pos="0.08 0 0.02" xyaxes="0 -1 0 0 0 1" fovy="90"/>
    </body>
  </worldbody>

  <actuator>
    <general name="motor_fl" site="rotor_fl" gear="0 0 1 0 0 0.008"/>
    <general name="motor_fr" site="rotor_fr" gear="0 0 1 0 0 -0.008"/>
    <general name="motor_rl" site="rotor_rl" gear="0 0 1 0 0 -0.008"/>
    <general name="motor_rr" site="rotor_rr" gear="0 0 1 0 0 0.008"/>
  </actuator>
  <sensor>
    <rangefinder name="rangefinder_front" site="rotor_fl"/>
  </sensor>
</mujoco>
