<mujoco model="hover_obstacle">
  <compiler angle="radian" meshdir="." autolimits="true"/>

  <option timestep="0.002" iterations="1" ls_iterations="4">
    <flag eulerdamp="disable"/>
  </option>

  <default>
    <joint armature="0.001" damping="0.01" limited="true"/>
    <geom contype="1" conaffinity="1" friction="0.3 0.005 0.0001" rgba="0.3 0.5 0.7 1"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.8 1.0" rgb2="0.2 0.4 0.8" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.9 0.9 0.9" rgb2="0.7 0.7 0.7" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" reflectance="0.1"/>
    <material name="obstacle_mat" rgba="0.8 0.2 0.2 0.8"/>
    <material name="goal_mat" rgba="0.2 0.8 0.2 0.5"/>
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 0 5" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="50 50 0.1" material="grid_mat"/>

    <!-- Static obstacle: a box -->
    <body name="obstacle_box" pos="0.0 0.0 0.5">
      <geom name="obstacle_geom" type="box" size="0.2 0.2 0.5" material="obstacle_mat"/>
    </body>

    <!-- Goal marker (visual only) -->
    <body name="goal" pos="0.0 0.0 1.0">
      <geom name="goal_geom" type="sphere" size="0.1" material="goal_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Quadrotor -->
    <body name="quadrotor" pos="0.0 0.0 0.15">
      <freejoint name="root"/>
      <geom name="body_geom" type="box" size="0.1 0.05 0.02" mass="0.75"/>

      <!-- Arm 1 -->
      <body name="arm1" pos="0.1 0.0 0.0">
        <geom name="arm1_geom" type="cylinder" size="0.01 0.1" euler="0 1.5708 0" mass="0.05"/>
        <site name="motor1" pos="0.1 0.0 0.0" size="0.01"/>
      </body>
      <!-- Arm 2 -->
      <body name="arm2" pos="-0.1 0.0 0.0">
        <geom name="arm2_geom" type="cylinder" size="0.01 0.1" euler="0 1.5708 0" mass="0.05"/>
        <site name="motor2" pos="-0.1 0.0 0.0" size="0.01"/>
      </body>
      <!-- Arm 3 -->
      <body name="arm3" pos="0.0 0.1 0.0">
        <geom name="arm3_geom" type="cylinder" size="0.01 0.1" euler="1.5708 0 0" mass="0.05"/>
        <site name="motor3" pos="0.0 0.1 0.0" size="0.01"/>
      </body>
      <!-- Arm 4 -->
      <body name="arm4" pos="0.0 -0.1 0.0">
        <geom name="arm4_geom" type="cylinder" size="0.01 0.1" euler="1.5708 0 0" mass="0.05"/>
        <site name="motor4" pos="0.0 -0.1 0.0" size="0.01"/>
      </body>

      <!-- Rangefinder -->
      <site name="rangefinder" pos="0.0 0.0 0.0" zaxis="0 0 -1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor1" site="motor1" gear="0 0 1 0.1 0 0" ctrllimited="true" ctrlrange="0 3"/>
    <motor name="motor2" site="motor2" gear="0 0 1 -0.1 0 0" ctrllimited="true" ctrlrange="0 3"/>
    <motor name="motor3" site="motor3" gear="0 0 1 0 0.1 0" ctrllimited="true" ctrlrange="0 3"/>
    <motor name="motor4" site="motor4" gear="0 0 1 0 -0.1 0" ctrllimited="true" ctrlrange="0 3"/>
  </actuator>

  <sensor>
    <rangefinder name="rangefinder" site="rangefinder"/>
  </sensor>
</mujoco>
